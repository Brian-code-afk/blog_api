# ============================================
# 使用方式:  cp .env.example .env   然后填真实值
# 本文件提交到 git；.env 已在 .gitignore 中，切勿提交
# ============================================

# ---------- 应用 ----------
APP_NAME=BlogAPI
ENV=dev# dev | test | prod（prod 时自动关闭调试与 SQL 回显）
HOST=0.0.0.0# 容器内必须是 0.0.0.0，不能是 127.0.0.1
PORT=8000
LOG_LEVEL=INFO# DEBUG | INFO | WARNING | ERROR

# ---------- 数据库 (MySQL) ----------
# 格式: mysql+pymysql://用户:密码@主机:端口/库名?charset=utf8mb4
# 注意: 密码含 @ # / % 等特殊字符需 URL 编码（@ → %40）
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>?charset=utf8mb4
DB_ECHO=false# 打印 SQL 语句，仅调试时开
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true# 容器重启后自动剔除连接池中的死连接

# ---------- Redis ----------
# 格式: redis://[:密码]@主机:端口/库号
REDIS_URL=redis://<REDIS_HOST>:6379/0

# ---------- 认证 / JWT ----------
# 生成命令见 README，生产环境绝不可复用开发密钥
JWT_SECRET=<GENERATE_ME>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_GRACE_SECONDS=60# 轮换宽限期，防网络抖动误登出
REFRESH_TOKEN_ROTATE=true

# ---------- CORS ----------
# JSON 数组格式。无前端时填 ["*"]，生产必须改成具体域名
CORS_ORIGINS=["*"]

# ---------- 分页 ----------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100