# ============================================================
# 生产环境配置模板
# 用法：复制成 .env.prod 后填入真实值，然后
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
#
# ⚠️ .env.prod 已在 .gitignore / .dockerignore 中排除，切勿提交、切勿进镜像
# ============================================================

APP_NAME=BlogAPI

# 生产环境标记：影响 settings.debug 与错误详情是否外露
ENV=prod

HOST=0.0.0.0
PORT=8000

# 生产环境不要用 DEBUG，否则每条 SQL 都打日志，磁盘几天就满
LOG_LEVEL=INFO

# 容器内由 docker-compose.prod.yml 覆盖成 db/redis，这里写占位即可
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@localhost:3306/blog?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0

# 生产务必关掉 SQL 回显
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# ⚠️ 必须换成全新随机值，绝不能沿用开发环境的
# 生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_GRACE_SECONDS=60
REFRESH_TOKEN_ROTATE=true

# 用 Nginx 同源反代后其实不触发 CORS，留空数组最安全
CORS_ORIGINS=[]

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ⚠️ 纯 ASCII、不含 @ # % / : 等 URL 特殊字符，且必须和上面 DATABASE_URL 里的一致
MYSQL_ROOT_PASSWORD=CHANGE_ME_ASCII_ONLY
MYSQL_DATABASE=blog
